{
    "name": "ono-core",
    "version": "1.2.5",
    "description": "ono cryptocurrency core",
    "main": "app.js",
    "scripts": {
        "test": "node --experimental-test-module-mocks --disable-warning=ExperimentalWarning --test \"tests/unit/**/*.test.js\" \"tests/property/**/*.test.js\" \"tests/fuzz/**/*.test.js\" \"tests/consensus/**/*.test.js\" \"tests/api/**/*.test.js\"",
        "test:unit": "node --experimental-test-module-mocks --disable-warning=ExperimentalWarning --test \"tests/unit/**/*.test.js\"",
        "test:property": "node --experimental-test-module-mocks --disable-warning=ExperimentalWarning --test \"tests/property/**/*.test.js\" \"tests/fuzz/**/*.test.js\"",
        "test:consensus": "node --experimental-test-module-mocks --disable-warning=ExperimentalWarning --test \"tests/consensus/**/*.test.js\"",
        "test:api": "node --experimental-test-module-mocks --disable-warning=ExperimentalWarning --test \"tests/api/**/*.test.js\"",
        "test:integration": "node --env-file=.env.test.local --experimental-test-module-mocks --disable-warning=ExperimentalWarning --test \"tests/integration/**/*.test.js\"",
        "test:coverage": "node --experimental-test-module-mocks --disable-warning=ExperimentalWarning --experimental-test-coverage --test-coverage-include='services/**' --test-coverage-include='lib/**' --test-coverage-include='controllers/**' --test-coverage-include='constructors/**' --test-coverage-include='p2p/**' --test \"tests/unit/**/*.test.js\" \"tests/property/**/*.test.js\" \"tests/fuzz/**/*.test.js\" \"tests/consensus/**/*.test.js\" \"tests/api/**/*.test.js\"",
        "clean-start": "node app.js",
        "start": "node --env-file=.env app.js",
        "dev": "node --env-file=.env --watch app.js | pino-pretty -S -i pid,hostname",
        "dev-test-1": "node --env-file=.env.development.local-1 --watch app.js | pino-pretty -S -i pid,hostname",
        "dev-test-2": "node --env-file=.env.development.local-2 --watch app.js | pino-pretty -S -i pid,hostname"
    },
    "author": "",
    "license": "ISC",
    "dependencies": {
        "ajv": "^8.17.1",
        "big.js": "^6.2.2",
        "bip39": "^3.1.0",
        "cors": "^2.8.5",
        "elliptic": "^6.6.0",
        "express-openapi-validator": "^5.3.9",
        "hdkey": "^2.1.0",
        "pg": "^8.13.1",
        "pino": "^9.5.0",
        "pluralize": "^8.0.0",
        "sequelize": "^6.37.5",
        "ws": "^8.18.0"
    },
    "devDependencies": {
        "pino-pretty": "^11.3.0"
    }
}
